{
  "metadata": {
    "description": "HTML中用于处理数学符号、电器/光电产品规格单位符号、数字上下标等最详细的标签、实体和特殊字符集合。",
    "note": "本列表包含HTML标签、字符实体（Entity Name）、数字实体（Decimal/Hex）以及可直接使用的Unicode字符。所有实体名称均区分大小写。[reference:0]"
  },
  "categories": {
    "formatting_tags": {
      "description": "用于文本格式化的HTML标签，直接改变文本的显示方式。",
      "tags": [
        {
          "tag": "<sup>",
          "description": "上标标签。将文本显示为比当前基线更高的上标，通常字号也更小。[reference:1][reference:2]",
          "example": "E = mc<sup>2</sup> 显示为 E = mc²"
        },
        {
          "tag": "<sub>",
          "description": "下标标签。将文本显示为比当前基线更低的下标，通常字号也更小。[reference:3][reference:4]",
          "example": "H<sub>2</sub>O 显示为 H₂O"
        },
        {
          "tag": "<small>",
          "description": "小号字标签。将文本显示为较小的字号。[reference:5]",
          "example": "这是<small>小号</small>文字"
        },
        {
          "tag": "<big>",
          "description": "大号字标签（已废弃，不推荐使用）。将文本显示为较大的字号。",
          "example": "这是<big>大号</big>文字"
        }
      ]
    },
    "mathml_tags": {
      "description": "MathML（数学标记语言）标签，用于在Web页面中结构化地展示数学公式和符号。[reference:7]",
      "note": "MathML是一种基于XML的语言，分为内容模型和表现模型。以下为表现模型（Presentation MathML）的常用标签。[reference:8][reference:9]",
      "tags": [
        {
          "tag": "<math>",
          "description": "MathML的根元素，用于定义数学区域。[reference:10]",
          "example": "<math>...</math>"
        },
        {
          "tag": "<mi>",
          "description": "标识符，用于表示变量名、函数名等。[reference:11]",
          "example": "<mi>x</mi> 表示变量 x"
        },
        {
          "tag": "<mn>",
          "description": "数字，用于表示整数、浮点数等。[reference:12]",
          "example": "<mn>2</mn> 表示数字 2"
        },
        {
          "tag": "<mo>",
          "description": "运算符，用于表示加法、减法、乘法等运算符号。[reference:13]",
          "example": "<mo>+</mo> 表示加号"
        },
        {
          "tag": "<msup>",
          "description": "上标，用于表示指数或上标形式。[reference:14]",
          "example": "<msup><mi>x</mi><mn>2</mn></msup> 表示 x²"
        },
        {
          "tag": "<msub>",
          "description": "下标，用于表示下标形式。[reference:15]",
          "example": "<msub><mi>x</mi><mn>1</mn></msub> 表示 x₁"
        },
        {
          "tag": "<msubsup>",
          "description": "上下标，同时表示上标和下标。",
          "example": "<msubsup><mi>x</mi><mi>i</mi><mn>2</mn></msubsup>"
        },
        {
          "tag": "<mfrac>",
          "description": "分数，用于表示分数形式。[reference:16]",
          "example": "<mfrac><mn>1</mn><mn>2</mn></mfrac> 表示 ½"
        },
        {
          "tag": "<mroot>",
          "description": "根号，用于表示开方运算。[reference:17]",
          "example": "<mroot><mi>x</mi><mn>3</mn></mroot> 表示 ∛x"
        },
        {
          "tag": "<msqrt>",
          "description": "平方根，用于表示平方根。",
          "example": "<msqrt><mi>x</mi></msqrt> 表示 √x"
        },
        {
          "tag": "<mrow>",
          "description": "行容器，用于组合多个数学元素。[reference:18]",
          "example": "<mrow><mi>a</mi><mo>+</mo><mi>b</mi></mrow>"
        }
      ]
    },
    "superscripts_and_subscripts_unicode": {
      "description": "可直接使用的Unicode上标和下标字符，无需使用HTML标签。[reference:19]",
